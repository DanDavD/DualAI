# ============================================================================
# DualAI Desktop Client Environment Variables (PUBLIC ONLY - ZERO SECRETS)
# ============================================================================
# SECURITY MANDATE:
# NEVER place DEEPGRAM_API_KEY, GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# or billing secrets in this file. Any VITE_* variable is bundled into the
# Electron renderer binary and is publicly inspectable.
# All provider secrets live exclusively in server/.env on the Cloud Gateway.

# DualAI Zero-Trust Cloud Gateway URL (local dev default: http://localhost:8787)
VITE_GATEWAY_URL=http://localhost:8787

# Public Supabase Project URL & Publishable Anon Key (RLS-protected read-only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
