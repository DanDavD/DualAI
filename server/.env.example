# ============================================================================
# DualAI Zero-Trust Cloud Gateway Secrets (SERVER-ONLY - NEVER SHIP TO CLIENT)
# Copy to server/.env for local testing, or inject via Railway / Fly.io Secrets
# ============================================================================

NODE_ENV=development
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,app://dualai

# Active Real-Time STT Provider Switch: 'deepgram' | 'soniox' | 'auto'
# Set STT_PROVIDER=deepgram to use Deepgram + Gemini while keeping SONIOX_API_KEY untouched ($0 Soniox cost).
# Switch back to STT_PROVIDER=soniox anytime to reactivate Soniox Unified.
STT_PROVIDER=auto

# Primary Unified Real-Time AI Engine: Soniox (STT + 15-Speaker Diarization + 2-Way Translation)
# NEVER exposed to Electron clients or DB
SONIOX_API_KEY=your_server_only_soniox_api_key
SONIOX_MODEL=stt-rt-v6

# Deepgram Streaming STT (Nova-3 Multilingual + Diarization) + Gemini Real-Time Translation
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Supabase Authoritative Auth & Quota Persistence (service_role NEVER in client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Store Collections & Subscriptions API (Entra ID Server Credentials)
# Supports Honduras / global developers via Microsoft Partner Center payouts
MS_STORE_TENANT_ID=
MS_STORE_CLIENT_ID=
MS_STORE_CLIENT_SECRET=

# Paddle Merchant of Record & Cross-Platform Billing Webhook
# Webhook notification signing secret (created under Events > Notifications, starts with pdl_ntfset_...)
# IMPORTANT: This must be the notification destination endpoint secret, NOT your Paddle API key!
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

# Server-only Paddle API key for customer portal & subscription management (starts with pdl_live_apikey_...)
PADDLE_API_KEY=
PADDLE_ENV=production
PAYPAL_CHECKOUT_BASE_URL=https://checkout.dualai.app/paypal
PADDLE_CHECKOUT_BASE_URL=https://dualai.universalaisync.com/checkout

# Local Development HMAC Session Secret (strictly ignored when NODE_ENV=production)
DEV_LOCAL_AUTH_SECRET=dualai_local_dev_hmac_secret_change_in_prod
