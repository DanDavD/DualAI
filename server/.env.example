# ============================================================================
# DualAI Zero-Trust Cloud Gateway Secrets (SERVER-ONLY - NEVER SHIP TO CLIENT)
# Copy to server/.env for local testing, or inject via Railway / Fly.io Secrets
# ============================================================================

NODE_ENV=development
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,app://dualai

# Upstream AI Provider Secrets (NEVER exposed to Electron clients or DB)
DEEPGRAM_API_KEY=your_server_only_deepgram_api_key
GEMINI_API_KEY=your_server_only_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Authoritative Auth & Quota Persistence (service_role NEVER in client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Store Collections & Subscriptions API (Entra ID Server Credentials)
# Supports Honduras / global developers via Microsoft Partner Center payouts
MS_STORE_TENANT_ID=
MS_STORE_CLIENT_ID=
MS_STORE_CLIENT_SECRET=

# Cross-Platform Billing Webhook Secret (PayPal / Paddle for macOS & Web - Honduras compatible)
BILLING_WEBHOOK_SECRET=

# Local Development HMAC Session Secret (strictly ignored when NODE_ENV=production)
DEV_LOCAL_AUTH_SECRET=dualai_local_dev_hmac_secret_change_in_prod
